{
	"name": "df_derived_column",
	"properties": {
		"folder": {
			"name": "df_20260619"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_datafiles_input",
						"type": "DatasetReference"
					},
					"name": "srcEmployee"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "ls_adls_datasource",
						"type": "LinkedServiceReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          EmpNo as short,",
				"          EName as string,",
				"          Job as string,",
				"          HireDate as date,",
				"          Salary as integer,",
				"          Comission as double,",
				"          DeptNo as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> srcEmployee",
				"srcEmployee derive(Hike = case(\r",
				"    DeptNo==10, Salary*0.1,\r",
				"    DeptNo==20, Salary*0.2,\r",
				"    DeptNo==30, Salary*0.3,\r",
				"    Salary*0.4\r",
				")) ~> derivedColumn1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delimited',",
				"     fileSystem: 'datasource',",
				"     folderPath: 'output/empSalHike',",
				"     columnDelimiter: ',',",
				"     escapeChar: '\\\\',",
				"     quoteChar: '',",
				"     columnNamesAsHeader: true,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     mapColumn(",
				"          EmpNo,",
				"          EName,",
				"          Job,",
				"          HireDate,",
				"          Salary,",
				"          Comission,",
				"          DeptNo,",
				"          Hike",
				"     )) ~> sink1"
			]
		}
	}
}